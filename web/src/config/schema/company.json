{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "short": {
      "type": "string",
      "maxLength": 4
    },
    "industry": {
      "type": "string"
    },
    "tariff": {
      "type": "object",
      "properties": {
        "power": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "number",
                "minimum": 0,
                "maximum": 23
              },
              "to": {
                "type": "number",
                "minimum": 1,
                "maximum": 24
              },
              "price": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "from",
              "to",
              "price"
            ]
          }
        },
        "gas": {
          "default": 0,
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "power"
      ]
    },
    "plants": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "badge": {
            "type": "string",
            "maxLength": 3
          },
          "hall": {
            "default": "生产车间",
            "type": "string"
          },
          "site": {
            "default": "hall",
            "type": "string",
            "enum": [
              "hall",
              "outdoor",
              "shop"
            ]
          },
          "sub": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          },
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "note": {
                  "default": "",
                  "type": "string"
                },
                "product": {
                  "type": "string"
                },
                "input": {
                  "type": "string"
                },
                "route": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "machine": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "cycle": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "makes": {
                            "type": "string"
                          },
                          "measure": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string"
                              },
                              "unit": {
                                "type": "string"
                              },
                              "target": {
                                "type": "number"
                              },
                              "lo": {
                                "type": "number"
                              },
                              "hi": {
                                "type": "number"
                              },
                              "sigma": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "drift": {
                                "default": 1,
                                "anyOf": [
                                  {
                                    "type": "number",
                                    "const": 1
                                  },
                                  {
                                    "type": "number",
                                    "const": -1
                                  }
                                ]
                              },
                              "abs": {
                                "default": false,
                                "type": "boolean"
                              },
                              "digits": {
                                "default": 1,
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "speedBias": {
                                "default": 0,
                                "type": "number"
                              },
                              "wear": {
                                "default": {
                                  "shift": 4,
                                  "spread": 2.5
                                },
                                "type": "object",
                                "properties": {
                                  "shift": {
                                    "type": "number",
                                    "minimum": 0
                                  },
                                  "spread": {
                                    "type": "number",
                                    "minimum": 0
                                  }
                                },
                                "required": [
                                  "shift",
                                  "spread"
                                ]
                              },
                              "defects": {
                                "type": "object",
                                "properties": {
                                  "lo": {
                                    "type": "string"
                                  },
                                  "hi": {
                                    "type": "string"
                                  }
                                }
                              },
                              "rework": {
                                "default": false,
                                "type": "boolean"
                              },
                              "wait": {
                                "type": "number"
                              },
                              "heat": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "label",
                              "unit",
                              "target",
                              "sigma"
                            ]
                          },
                          "power": {
                            "type": "object",
                            "properties": {
                              "idle": {
                                "type": "number"
                              },
                              "run": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "idle",
                              "run"
                            ]
                          },
                          "tooling": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string"
                              },
                              "life": {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              },
                              "change": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "spare": {
                                "type": "string"
                              },
                              "drift": {
                                "type": "number",
                                "minimum": 0
                              },
                              "limit": {
                                "type": "number",
                                "minimum": 0.3,
                                "maximum": 1
                              },
                              "setup": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "warm": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "cost": {
                                "type": "number",
                                "minimum": 0
                              }
                            }
                          },
                          "take": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "give": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "slots": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "seats": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "bySize": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            }
                          },
                          "until": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 24
                          },
                          "perPerson": {
                            "type": "boolean"
                          },
                          "place": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "default": "桌",
                                "type": "string"
                              },
                              "size": {
                                "default": [
                                  2.4,
                                  2.4
                                ],
                                "type": "array",
                                "prefixItems": [
                                  {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                  },
                                  {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                  }
                                ],
                                "items": false,
                                "minItems": 2,
                                "maxItems": 2
                              }
                            }
                          }
                        },
                        "required": [
                          "machine"
                        ]
                      }
                    ]
                  }
                },
                "repeat": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "speed": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "beltHeight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "order": {
                  "type": "object",
                  "properties": {
                    "no": {
                      "type": "string"
                    },
                    "part": {
                      "type": "string"
                    },
                    "qty": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "tables": {
                  "type": "object",
                  "properties": {
                    "prefix": {
                      "type": "string"
                    },
                    "area": {
                      "type": "string"
                    },
                    "seats": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "list": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9-]{1,12}$"
                          },
                          "seats": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "area": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "seats"
                        ]
                      }
                    }
                  }
                }
              },
              "required": [
                "name",
                "product"
              ]
            }
          },
          "warehouse": {
            "default": "原料立体库",
            "type": "string"
          },
          "inventory": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "finishedGoods": {
            "default": "成品库",
            "type": "string"
          },
          "carriers": {
            "default": [
              "顺达物流",
              "远航货运"
            ],
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "freight": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "carrier": {
                  "type": "string"
                },
                "share": {
                  "default": 1,
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "late": {
                  "default": 0.1,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "truck": {
                  "default": 25,
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "carrier"
              ]
            }
          },
          "supply": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "depart": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 24
                }
              },
              "transit": {
                "default": 1,
                "type": "number",
                "exclusiveMinimum": 0
              },
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "from",
              "depart",
              "items"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "lines"
        ]
      }
    },
    "ontology": {}
  },
  "required": [
    "id",
    "name",
    "short",
    "industry",
    "plants"
  ]
}
