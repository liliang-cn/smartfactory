  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "short": {
      "type": "string",
      "maxLength": 4
    },
    "industry": {
      "type": "string"
    },
    "tariff": {
      "type": "object",
      "properties": {
        "power": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "number",
                "minimum": 0,
                "maximum": 23
              },
              "to": {
                "type": "number",
                "minimum": 1,
                "maximum": 24
              },
              "price": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "from",
              "to",
              "price"
            ]
          }
        },
        "gas": {
          "default": 0,
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "power"
      ]
    },
    "plants": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "badge": {
            "type": "string",
            "maxLength": 3
          },
          "hall": {
            "default": "生产车间",
            "type": "string"
          },
          "site": {
            "default": "hall",
            "type": "string",
            "enum": [
              "hall",
              "outdoor",
              "shop"
            ]
          },
          "sub": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          },
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "note": {
                  "default": "",
                  "type": "string"
                },
                "product": {
                  "type": "string"
                },
                "input": {
                  "type": "string"
                },
                "route": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "machine": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "cycle": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "makes": {
                            "type": "string"
                          },
                          "measure": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string"
                              },
                              "unit": {
                                "type": "string"
                              },
                              "target": {
                                "type": "number"
                              },
                              "lo": {
                                "type": "number"
                              },
                              "hi": {
                                "type": "number"
                              },
                              "sigma": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "drift": {
                                "default": 1,
                                "anyOf": [
                                  {
                                    "type": "number",
                                    "const": 1
                                  },
                                  {
                                    "type": "number",
                                    "const": -1
                                  }
                                ]
                              },
                              "abs": {
                                "default": false,
                                "type": "boolean"
                              },
                              "digits": {
                                "default": 1,
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "speedBias": {
                                "default": 0,
                                "type": "number"
                              },
                              "wear": {
                                "default": {
                                  "shift": 4,
                                  "spread": 2.5
                                },
                                "type": "object",
                                "properties": {
                                  "shift": {
                                    "type": "number",
                                    "minimum": 0
                                  },
                                  "spread": {
                                    "type": "number",
                                    "minimum": 0
                                  }
                                },
                                "required": [
                                  "shift",
                                  "spread"
                                ]
                              },
                              "defects": {
                                "type": "object",
                                "properties": {
                                  "lo": {
                                    "type": "string"
                                  },
                                  "hi": {
                                    "type": "string"
                                  }
                                }
                              },
                              "rework": {
                                "default": false,
                                "type": "boolean"
                              },
                              "wait": {
                                "type": "number"
                              },
                              "heat": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "label",
                              "unit",
                              "target",
                              "sigma"
                            ]
                          },
                          "power": {
                            "type": "object",
                            "properties": {
                              "idle": {
                                "type": "number"
                              },
                              "run": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "idle",
                              "run"
                            ]
                          },
                          "tooling": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string"
                              },
                              "life": {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              },
                              "change": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "spare": {
                                "type": "string"
                              },
                              "drift": {
                                "type": "number",
                                "minimum": 0
                              },
                              "limit": {
                                "type": "number",
                                "minimum": 0.3,
                                "maximum": 1
                              },
                              "setup": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "warm": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "cost": {
                                "type": "number",
                                "minimum": 0
                              }
                            }
                          },
                          "take": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "give": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "slots": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "seats": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "bySize": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            }
                          },
                          "until": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 24
                          },
                          "perPerson": {
                            "type": "boolean"
                          },
                          "place": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "default": "桌",
                                "type": "string"
                              },
                              "size": {
                                "default": [
                                  2.4,
                                  2.4
                                ],
                                "type": "array",
                                "prefixItems": [
                                  {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                  },
                                  {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                  }
                                ],
                                "items": false,
                                "minItems": 2,
                                "maxItems": 2
                              }
                            }
                          }
                        },
                        "required": [
                          "machine"
                        ]
                      }
                    ]
                  }
                },
                "repeat": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "speed": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "beltHeight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "order": {
                  "type": "object",
                  "properties": {
                    "no": {
                      "type": "string"
                    },
                    "part": {
                      "type": "string"
                    },
                    "qty": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "tables": {
                  "type": "object",
                  "properties": {
                    "prefix": {
                      "type": "string"
                    },
                    "area": {
                      "type": "string"
                    },
                    "seats": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "list": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9-]{1,12}$"
                          },
                          "seats": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "area": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "seats"
                        ]
                      }
                    }
                  }
                }
              },
              "required": [
                "name",
                "product"
              ]
            }
          },
          "warehouse": {
            "default": "原料立体库",
            "type": "string"
          },
          "inventory": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "finishedGoods": {
            "default": "成品库",
            "type": "string"
          },
          "carriers": {
            "default": [
              "顺达物流",
              "远航货运"
            ],
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "freight": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "carrier": {
                  "type": "string"
                },
                "share": {
                  "default": 1,
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "late": {
                  "default": 0.1,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "truck": {
                  "default": 25,
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "carrier"
              ]
            }
          },
          "demand": {
            "type": "object",
            "properties": {
              "rate": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "curve": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 24
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "week": {
                "minItems": 7,
                "maxItems": 7,
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "sizes": {
                "default": [
                  0.12,
                  0.38,
                  0.22,
                  0.16,
                  0.08,
                  0.04
                ],
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "patience": {
                "default": [
                  20,
                  70
                ],
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "balk": {
                "default": 6,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "fee": {
                "default": 0,
                "type": "number",
                "minimum": 0
              },
              "takeaway": {
                "type": "object",
                "properties": {
                  "rate": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "take": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "prep": {
                    "default": 12,
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "spend": {
                    "default": [
                      60,
                      140
                    ],
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "rate",
                  "take"
                ]
              },
              "weather": {
                "type": "object",
                "properties": {
                  "rain": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "factor": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                },
                "required": [
                  "rain",
                  "factor"
                ]
              }
            },
            "required": [
              "rate",
              "curve"
            ]
          },
          "kpis": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "oee",
                    "throughput",
                    "quality",
                    "power",
                    "turnover",
                    "occupancy",
                    "queue",
                    "ticket",
                    "rating",
                    "served",
                    "takeaway",
                    "checkins",
                    "inUse",
                    "weather",
                    "onTime",
                    "coldChain"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": [
                        "oee",
                        "throughput",
                        "quality",
                        "power",
                        "turnover",
                        "occupancy",
                        "queue",
                        "ticket",
                        "rating",
                        "served",
                        "takeaway",
                        "checkins",
                        "inUse",
                        "weather",
                        "onTime",
                        "coldChain"
                      ]
                    },
                    "item": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              ]
            }
          },
          "supply": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "depart": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 24
                }
              },
              "transit": {
                "default": 1,
                "type": "number",
                "exclusiveMinimum": 0
              },
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "from",
              "depart",
              "items"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "lines"
        ]
      }
    },
    "ontology": {
      "type": "object",
      "properties": {
        "classes": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "sub": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "relations": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "range": {
                "type": "string"
              },
              "transitive": {
                "type": "boolean"
              },
              "symmetric": {
                "type": "boolean"
              },
              "inverse": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "rules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "if": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "then": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "if",
              "then"
            ]
          }
        },
        "individuals": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "bind": {
          "default": {
            "products": {},
            "machines": {},
            "individuals": {}
          },
          "type": "object",
          "properties": {
            "products": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "machines": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "individuals": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "constraints": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "class": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "for": {
                "type": "number",
                "minimum": 0
              },
              "requires": {
                "type": "string"
              },
              "valueClass": {
                "type": "string"
              },
              "say": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "class"
            ]
          }
        }
      }
    }
  },
  "required": [
    "id",
    "name",
    "short",
    "industry",
    "plants"
  ]
}
