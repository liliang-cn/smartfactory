{
  "scrape": ["http://192.168.1.30:9100/metrics"],
  "every": "2s",
  "metrics": {
    "cpu0": { "name": "node_hwmon_temp_celsius", "labels": { "chip": "platform_coretemp_0", "sensor": "temp1" } },
    "cpu1": { "name": "node_hwmon_temp_celsius", "labels": { "chip": "platform_coretemp_1", "sensor": "temp1" } },
    "nvme": { "name": "node_hwmon_temp_celsius", "labels": { "chip": "nvme_nvme0", "sensor": "temp1" } }
  },
  "mqtt": {
    "url": "tcp://192.168.1.10:41883",
    "username": "edge",
    "password": "change-me",
    "publish": [{ "metric": "cpu0", "topic": "sf/huaduan/p1/HP-101/temp" }],
    "buffer": "/var/lib/smartfactory-edge/buffer.jsonl",
    "bufferMax": 100000
  },
  "modbus": { "listen": "0.0.0.0:41502", "holding": [{ "metric": "cpu1", "address": 0, "scale": 10 }] },
  "opcua": { "host": "192.168.1.20", "port": 41840, "nodes": [{ "metric": "nvme", "node": "dell.nvme.temp" }] }
}
